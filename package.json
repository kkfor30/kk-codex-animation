    "artwork": "node scripts/render.mjs assets",
    "verify": "python scripts/verify.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/bundler": "4.0.529",
