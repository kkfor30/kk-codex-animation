    "react": "19.2.3",
    "react-dom": "19.2.3",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6"
  },
